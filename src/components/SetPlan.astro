---
import { trim } from '../lib/format'
import { repsLabel, type PlannedSet } from '../lib/scheme'

interface Props {
  sets: PlannedSet[]
  /** Serie que toca ahora (1-based). Se resalta durante el entreno. */
  current?: number | null
  /** Series ya registradas: se atenúan para ver de un golpe lo que falta. */
  done?: number
  /** El número de serie se oculta cuando solo se quiere leer el plan. */
  numbered?: boolean
}

const { sets, current = null, done = 0, numbered = true }: Props = Astro.props
---

<ol class="grid gap-1">
  {
    sets.map((set, i) => {
      const n = i + 1
      const active = current === n
      const complete = n <= done

      // `aria-current="step"` a propósito y no `"true"`: session.ts busca la
      // parada abierta con `nav a[aria-current="true"]`, y esto no es un <a>,
      // no está en un <nav> y el valor es distinto. No cambiar a "true".
      return (
        <li
          class:list={[
            'flex items-baseline gap-2.5 rounded-field px-2 py-1.5',
            active && 'border border-sodium/40 bg-sodium/10',
            complete && !active && 'opacity-45',
            set.isDropSet && 'ml-5',
          ]}
          aria-current={active ? 'step' : undefined}
        >
          {numbered && (
            <span
              class:list={[
                'readout w-5 shrink-0 text-center text-xs',
                active ? 'text-sodium' : complete ? 'text-go' : 'text-ash-dim',
              ]}
            >
              {complete && !active ? '✓' : set.isDropSet ? '↳' : n}
            </span>
          )}

          <span
            class:list={[
              'readout text-sm',
              set.toFailure ? 'text-signal' : active ? 'text-chalk' : 'text-ash',
            ]}
          >
            {repsLabel(set)}
            {!set.toFailure && <span class="stencil ml-1 text-ash-dim">reps</span>}
          </span>

          {set.weight !== null && (
            <span class="readout text-sm text-sodium">
              {trim(set.weight)}
              <span class="stencil ml-1 text-ash-dim">kg</span>
            </span>
          )}

          {set.isDropSet && (
            <span class="stencil text-ash-dim">
              drop{set.dropPct !== null ? ` −${set.dropPct}%` : ''} · sin descanso
            </span>
          )}
        </li>
      )
    })
  }
</ol>
