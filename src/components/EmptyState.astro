---
interface Props {
  title: string
  hint?: string
}

const { title, hint }: Props = Astro.props
---

<div class="slab relative overflow-hidden px-5 py-12 text-center">
  {/* Filete de acento que se apaga hacia la derecha. */}
  <div class="hazard absolute inset-x-0 top-0 h-px" aria-hidden="true"></div>
  <h3 class="text-2xl text-chalk">{title}</h3>
  {hint && <p class="mx-auto mt-2.5 max-w-sm text-sm leading-relaxed text-ash">{hint}</p>}
  <div class="mt-6">
    <slot />
  </div>
</div>
