---
import { SignOutButton } from '@clerk/astro/components';

import { prisma } from '../lib/prisma';
import { getCurrentUser } from '../lib/session';

const user = await getCurrentUser(Astro.locals);
const path = Astro.url.pathname;

// Si hay una sesión abierta, la barra la anuncia desde cualquier página:
// es lo único que el usuario no puede permitirse olvidar.
const openSession = await prisma.workoutSession.findFirst({
  where: { userId: user.id, status: 'in_progress' },
  select: { id: true, routineName: true },
});

const links = [
  { href: '/', label: 'Hoy' },
  { href: '/rutinas', label: 'Rutinas' },
  { href: '/ejercicios', label: 'Ejercicios' },
  { href: '/historial', label: 'Historial' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!--
  El alto de esta barra es `--nav-h` (global.css). `historial.astro` pega
  sus cabeceras de mes justo debajo con `top-[var(--nav-h)]`, así que si
  cambia el padding de aquí hay que mover esa variable, no el otro archivo.
-->
<header
  class="sticky top-0 z-50 h-[var(--nav-h)] border-b border-steel bg-void/80 backdrop-blur-xl"
>
  <div class="mx-auto flex h-full max-w-5xl items-center gap-2 px-4 sm:gap-4">
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label="Inicio">
      <!-- Vista frontal de un disco olímpico -->
      <svg viewBox="0 0 24 24" class="size-5 shrink-0" aria-hidden="true">
        <circle cx="12" cy="12" r="11" fill="none" stroke="var(--color-sodium)" stroke-width="2"
        ></circle>
        <circle cx="12" cy="12" r="3.5" fill="var(--color-sodium)"></circle>
      </svg>
      <span class="hidden font-display text-lg leading-none tracking-[-0.015em] sm:block">
        Tracker<span class="text-sodium">Gym</span>
      </span>
    </a>

    <nav class="flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'shrink-0 rounded-full px-3 py-1.5 text-[0.8125rem] font-medium transition-colors',
              isActive(link.href)
                ? 'bg-sodium/12 text-sodium'
                : 'text-ash hover:bg-panel-hi hover:text-chalk',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {
      openSession && !path.startsWith('/sesion/') && (
        <a
          href={`/sesion/${openSession.id}`}
          class="btn btn-sm btn-primary shrink-0"
          title={openSession.routineName ?? 'Entreno libre'}
        >
          <span class="size-1.5 shrink-0 animate-pulse rounded-full bg-[#1a1204]" />
          En curso
        </a>
      )
    }

    <SignOutButton asChild redirectUrl="/login">
      <button
        type="button"
        class="shrink-0 rounded-full px-3 py-1.5 text-[0.8125rem] font-medium text-ash transition-colors hover:bg-panel-hi hover:text-chalk"
        title={user.displayName}
      >
        Salir
      </button>
    </SignOutButton>
  </div>
</header>
