---
interface Props {
  id: string
  name: string
  description?: string | null
  color?: string | null
  exerciseCount: number
  muscles: string[]
  delay?: number
}

const { id, name, description, color, exerciseCount, muscles, delay = 0 }: Props =
  Astro.props

const accent = color ?? '#FFB000'
---

<a
  href={`/rutinas/${id}`}
  class="slab slab-lift rise group relative flex flex-col overflow-hidden p-4 pl-5"
  style={`animation-delay:${delay * 70}ms`}
>
  <!-- Canto de color: identifica la rutina de un vistazo en el calendario -->
  <span
    class="absolute inset-y-0 left-0 w-1.5"
    style={`background:${accent}`}
    aria-hidden="true"></span>

  <div class="flex items-start justify-between gap-3">
    <h3 class="text-xl leading-tight group-hover:text-sodium">{name}</h3>
    <span class="readout shrink-0 text-2xl text-steel-hi group-hover:text-ash">
      {String(exerciseCount).padStart(2, '0')}
    </span>
  </div>

  {
    description && (
      <p class="mt-1.5 line-clamp-2 text-sm text-ash">{description}</p>
    )
  }

  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4">
    {
      muscles.length > 0 ? (
        muscles.map((m) => (
          <span class="stencil border border-steel px-1.5 py-0.5 text-ash-dim">
            {m}
          </span>
        ))
      ) : (
        <span class="stencil text-ash-dim">Sin ejercicios</span>
      )
    }
  </div>
</a>
