---
import { actions } from 'astro:actions'
import { WEEK_DAYS, weekDayLabels } from '../lib/format'

interface Props {
  id: string
  name: string
  description?: string | null
  color?: string | null
  exerciseCount: number
  muscles: string[]
  /** Días del plan semanal, en `dow` crudo (0 = domingo). */
  dows?: number[]
  delay?: number
}

const {
  id,
  name,
  description,
  color,
  exerciseCount,
  muscles,
  dows = [],
  delay = 0,
}: Props = Astro.props

const accent = color ?? '#E8A33D'
const href = `/rutinas/${id}`

/** L M X J V S D, en el mismo orden que WEEK_DAYS (lunes primero). */
const LETTERS = ['L', 'M', 'X', 'J', 'V', 'S', 'D']
const assigned = new Set(dows)
const dayLabels = weekDayLabels(dows)
---

{/*
  Deja de ser un <a> que lo envuelve todo: ahora lleva dentro el formulario
  de "Empezar", y un <form> no puede ir dentro de un enlace. El enlace al
  detalle lo estira el título con `after:inset-0`, y la fila de acciones se
  queda por encima con `z-10`.
*/}
<article
  class="slab slab-lift rise group relative flex flex-col overflow-hidden p-5 pl-6"
  style={`animation-delay:${delay * 70}ms`}
>
  {/* Lavado + canto del color de la rutina: la identifica de un vistazo. */}
  <div
    class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-[0.07]"
    style={`background:radial-gradient(80% 120% at 0% 0%, ${accent}, transparent 60%)`}
    aria-hidden="true"
  >
  </div>
  <span
    class="absolute inset-y-0 left-0 w-[3px]"
    style={`background:linear-gradient(to bottom, ${accent}, transparent 90%)`}
    aria-hidden="true"></span>

  <div class="relative flex flex-1 flex-col">
    <h3 class="text-2xl leading-tight">
      <a href={href} class="transition-colors after:absolute after:inset-0 group-hover:text-sodium">
        {name}
      </a>
    </h3>

    {/* El número, rotulado: "10" a secas no le dice nada a nadie. */}
    <p class="stencil mt-2">
      <span class="readout mr-1.5 text-base text-chalk">{exerciseCount}</span>
      {exerciseCount === 1 ? 'ejercicio' : 'ejercicios'}
    </p>

    {
      description && (
        <p class="mt-2.5 line-clamp-2 text-sm leading-relaxed text-ash">{description}</p>
      )
    }

    {/* La semana en siete letras: se ve en qué días cae sin leer nada. */}
    <p class="mt-3 flex items-center gap-1">
      <span class="sr-only">
        {dayLabels.length > 0 ? `Días: ${dayLabels.join(', ')}` : 'Sin día asignado'}
      </span>
      {
        WEEK_DAYS.map((day, i) => (
          <span
            class:list={[
              'stencil flex size-5 items-center justify-center rounded-full',
              !assigned.has(day.dow) && 'text-steel-hi',
            ]}
            style={
              assigned.has(day.dow)
                ? `background:${accent}1f;color:${accent}`
                : undefined
            }
            aria-hidden="true"
          >
            {LETTERS[i]}
          </span>
        ))
      }
    </p>

    <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
      {
        muscles.length > 0 ? (
          muscles.map((m) => (
            <span class="stencil rounded-full border border-steel px-2 py-0.5 text-ash-dim">
              {m}
            </span>
          ))
        ) : (
          <span class="stencil text-ash-dim">Sin ejercicios</span>
        )
      }
    </div>

    {/* Encima del enlace estirado del título: si no, no se podrían pulsar. */}
    <div class="relative z-10 mt-4 flex flex-wrap gap-2">
      {
        exerciseCount > 0 ? (
          <>
            <form method="POST" action={actions.startSession}>
              <input type="hidden" name="routineId" value={id} />
              <button type="submit" class="btn btn-sm btn-primary">
                Empezar
              </button>
            </form>
            <a href={href} class="btn btn-sm btn-ghost">
              Ver
            </a>
          </>
        ) : (
          <a href={href} class="btn btn-sm btn-ghost">
            Agregar ejercicios
          </a>
        )
      }
    </div>
  </div>
</article>
