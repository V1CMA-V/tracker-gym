---
interface Props {
  label: string
  value: string
  unit?: string
  /** Índice para escalonar la entrada. */
  delay?: number
}

const { label, value, unit, delay = 0 }: Props = Astro.props
---

{/*
  Celda de una banda, no una cajita suelta: el contenedor pone el marco y
  los separadores. Cuatro cifras en una sola superficie se leen como una
  tabla; cuatro cajas se leen como cuatro cosas distintas.
*/}
<div class="rise bg-panel px-4 py-3.5" style={`animation-delay:${delay * 60}ms`}>
  <div class="stencil text-ash-dim">{label}</div>
  <div class="mt-2 flex items-baseline gap-1">
    <span class="readout text-2xl sm:text-[1.75rem]">{value}</span>
    {unit && <span class="stencil text-ash-dim">{unit}</span>}
  </div>
</div>
