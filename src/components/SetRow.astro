---
import { actions } from 'astro:actions'
import { num, trim, clock } from '../lib/format'
import type { Decimalish } from '../lib/format'

interface Props {
  id: string
  setNumber: number
  weight: Decimalish
  reps: number | null
  durationSeconds: number | null
  distanceMeters: Decimalish
  rpe: Decimalish
  isWarmup: boolean
  kind: string
  /** Destino del borrado. Se pasa para conservar el bloque abierto al volver. */
  action?: string
  /**
   * Récord personal.
   *
   * OJO: `renderRow()` en src/scripts/session.ts construye a mano una fila
   * equivalente para pintar la serie recién registrada sin recargar. Las
   * clases de las dos tienen que coincidir LITERALMENTE, o la fila nueva se
   * ve distinta a la misma fila después de recargar. Si tocas una, toca la
   * otra en el mismo commit.
   *
   * Hoy la página no pasa este prop: el dato de récord sale de
   * `v_personal_records` y solo lo consulta la action `logRound`, así que la
   * insignia la pinta únicamente el script. El markup vive aquí de todas
   * formas para que haya una sola definición que comparar.
   */
  isPR?: boolean
}

const {
  id,
  setNumber,
  weight,
  reps,
  durationSeconds,
  distanceMeters,
  rpe,
  isWarmup,
  kind,
  action = actions.deleteSet.queryString,
  isPR = false,
}: Props = Astro.props

const kg = num(weight)
const meters = num(distanceMeters)
const effort = num(rpe)

// Cada tipo de ejercicio se lee distinto: peso×reps, solo reps, tiempo o
// distancia. Se compone aquí para que la fila sea idéntica en todos.
const parts: { value: string; unit?: string }[] = []
if (kind === 'weight_reps' && kg !== null) parts.push({ value: trim(kg), unit: 'kg' })
if ((kind === 'weight_reps' || kind === 'bodyweight') && reps !== null)
  parts.push({ value: String(reps), unit: 'reps' })
if (kind === 'bodyweight' && kg) parts.push({ value: `+${trim(kg)}`, unit: 'kg' })
if (kind === 'duration' && durationSeconds !== null)
  parts.push({ value: clock(durationSeconds) })
if (kind === 'distance') {
  if (meters !== null) parts.push({ value: trim(meters / 1000), unit: 'km' })
  if (durationSeconds !== null) parts.push({ value: clock(durationSeconds) })
}
---

<li
  class:list={[
    'flex items-center gap-3 border-b border-steel py-3 last:border-b-0',
    isWarmup && 'opacity-50',
  ]}
  data-set-row
>
  <span
    class:list={[
      'readout w-8 shrink-0 text-center text-xs',
      isWarmup ? 'text-ash-dim' : 'text-sodium',
    ]}
  >
    {isWarmup ? 'W' : setNumber}
  </span>

  <div class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-3 gap-y-1">
    {
      parts.map((part) => (
        <span class="readout text-xl whitespace-nowrap">
          {part.value}
          {part.unit && <span class="stencil ml-1 text-ash-dim">{part.unit}</span>}
        </span>
      ))
    }
    {
      effort !== null && (
        <span class="stencil text-ash-dim">RPE {trim(effort)}</span>
      )
    }
    {
      isPR && (
        <span class="stencil rounded-full border border-sodium px-1.5 py-0.5 text-sodium">
          Récord
        </span>
      )
    }
  </div>

  <form method="POST" action={action} class="shrink-0">
    <input type="hidden" name="id" value={id} />
    <button
      type="submit"
      class="stencil flex size-9 items-center justify-center text-ash-dim hover:text-signal"
      aria-label={`Borrar serie ${setNumber}`}
    >
      ✕
    </button>
  </form>
</li>
