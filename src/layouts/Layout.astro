---
import '../styles/global.css'
import Nav from '../components/Nav.astro'

interface Props {
  title?: string
  description?: string
  /** La sesión activa se presenta a pantalla completa, sin la barra. */
  bare?: boolean
}

const {
  title = 'Tracker Gym',
  description = 'Registro de entrenamiento: rutinas, ejercicios y series.',
  bare = false,
}: Props = Astro.props

const fullTitle = title === 'Tracker Gym' ? title : `${title} · Tracker Gym`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="grain min-h-dvh">
    {!bare && <Nav />}
    {/*
      Las páginas `bare` (login, callback y la sesión activa) se dibujan a
      sangre: cada una centra o pega su propio contenido, así que el main
      no les mete márgenes. Así la barra de la sesión llega al borde de la
      pantalla sin compensar con márgenes negativos.
    */}
    <main class:list={[!bare && 'mx-auto max-w-5xl px-4 pt-9 pb-24']}>
      <slot />
    </main>
  </body>
</html>
