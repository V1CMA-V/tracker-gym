---
import { actions } from 'astro:actions'

import Layout from '../../layouts/Layout.astro'
import { prisma } from '../../lib/prisma'
import { getCurrentUser } from '../../lib/session'
import { backTo } from '../../lib/format'

const user = await getCurrentUser(Astro.locals)

const created = Astro.getActionResult(actions.createExercise)
const archivedResult = Astro.getActionResult(actions.archiveExercise)

// POST-redirect-GET conservando el filtro activo.
if ((created && !created.error) || (archivedResult && !archivedResult.error)) {
  return Astro.redirect(backTo(Astro.url), 303)
}
const error = created?.error?.message ?? archivedResult?.error?.message

// Filtros por querystring: enlaces normales, funcionan sin JavaScript.
const muscleFilter = Astro.url.searchParams.get('musculo')
const kindFilter = Astro.url.searchParams.get('tipo')

const KINDS = {
  weight_reps: 'Peso + reps',
  bodyweight: 'Peso corporal',
  duration: 'Tiempo',
  distance: 'Distancia',
} as const

const muscleGroups = await prisma.muscleGroup.findMany({ orderBy: { name: 'asc' } })

const exercises = await prisma.exercise.findMany({
  where: {
    isArchived: false,
    OR: [{ userId: null }, { userId: user.id }],
    ...(kindFilter && kindFilter in KINDS
      ? { kind: kindFilter as keyof typeof KINDS }
      : {}),
    ...(muscleFilter
      ? { muscles: { some: { muscleGroup: { name: muscleFilter } } } }
      : {}),
  },
  orderBy: [{ userId: 'desc' }, { name: 'asc' }],
  select: {
    id: true,
    name: true,
    kind: true,
    equipment: true,
    description: true,
    userId: true,
    muscles: {
      select: { isPrimary: true, muscleGroup: { select: { name: true } } },
      orderBy: { isPrimary: 'desc' },
    },
    _count: { select: { sessionEntries: true } },
  },
})

/** Conserva el resto de filtros al cambiar uno. */
const linkWith = (key: string, value: string | null) => {
  const params = new URLSearchParams(Astro.url.search)
  if (value) params.set(key, value)
  else params.delete(key)
  const qs = params.toString()
  return qs ? `?${qs}` : '/ejercicios'
}

const mine = exercises.filter((e) => e.userId !== null).length
---

<Layout title="Ejercicios">
  <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="stencil">Catálogo</p>
      <h1 class="mt-1 text-4xl sm:text-5xl">Ejercicios</h1>
    </div>
    <p class="stencil text-right">
      <span class="readout text-2xl text-chalk">{exercises.length}</span> visibles<br />
      <span class="text-ash-dim">{mine} propios</span>
    </p>
  </header>

  <!-- ===== Filtros ===== -->
  <div class="mb-6 grid gap-2">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="stencil w-14 shrink-0">Músculo</span>
      <a
        href={linkWith('musculo', null)}
        class:list={[
          'stencil border px-2 py-1 transition-colors',
          !muscleFilter
            ? 'border-sodium text-sodium'
            : 'border-steel hover:text-chalk',
        ]}
      >
        Todos
      </a>
      {
        muscleGroups.map((group) => (
          <a
            href={linkWith('musculo', group.name)}
            class:list={[
              'stencil border px-2 py-1 transition-colors',
              muscleFilter === group.name
                ? 'border-sodium text-sodium'
                : 'border-steel hover:text-chalk',
            ]}
          >
            {group.name}
          </a>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <span class="stencil w-14 shrink-0">Tipo</span>
      <a
        href={linkWith('tipo', null)}
        class:list={[
          'stencil border px-2 py-1 transition-colors',
          !kindFilter ? 'border-sodium text-sodium' : 'border-steel hover:text-chalk',
        ]}
      >
        Todos
      </a>
      {
        Object.entries(KINDS).map(([value, label]) => (
          <a
            href={linkWith('tipo', value)}
            class:list={[
              'stencil border px-2 py-1 transition-colors',
              kindFilter === value
                ? 'border-sodium text-sodium'
                : 'border-steel hover:text-chalk',
            ]}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>

  {
    error && (
      <p
        role="alert"
        class="mb-6 border-l-2 border-signal bg-signal/10 px-3 py-2 text-sm text-signal"
      >
        {error}
      </p>
    )
  }

  <!-- ===== Listado ===== -->
  {
    exercises.length > 0 ? (
      <ul class="grid gap-2 sm:grid-cols-2">
        {exercises.map((exercise, i) => (
          <li
            class="slab rise flex items-start gap-3 p-3.5"
            style={`animation-delay:${Math.min(i, 12) * 35}ms`}
          >
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <h3 class="truncate text-base">{exercise.name}</h3>
                {exercise.userId !== null && (
                  <span class="stencil shrink-0 border border-sodium-dim px-1 text-sodium">
                    Propio
                  </span>
                )}
              </div>

              <p class="stencil mt-1 truncate">
                {[
                  exercise.muscles[0]?.muscleGroup.name,
                  exercise.equipment,
                  KINDS[exercise.kind],
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </p>

              {exercise._count.sessionEntries > 0 && (
                <p class="stencil mt-1 text-ash-dim">
                  {exercise._count.sessionEntries} sesiones
                </p>
              )}
            </div>

            {exercise.userId !== null && (
              <form method="POST" action={actions.archiveExercise}>
                <input type="hidden" name="id" value={exercise.id} />
                <button
                  class="stencil shrink-0 hover:text-signal"
                  type="submit"
                  aria-label={`Archivar ${exercise.name}`}
                >
                  ✕
                </button>
              </form>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="slab px-5 py-8 text-center text-ash">
        Ningún ejercicio coincide con el filtro.
      </p>
    )
  }

  <!-- ===== Alta ===== -->
  <section class="slab mt-10 p-5">
    <h2 class="text-lg">Nuevo ejercicio</h2>
    <p class="mt-1 text-sm text-ash-dim">
      Se agrega a tu catálogo personal, junto al de la app.
    </p>

    <form method="POST" action={actions.createExercise} class="mt-4 grid gap-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="stencil mb-1.5 block" for="e-name">Nombre</label>
          <input
            id="e-name"
            name="name"
            class="field"
            required
            maxlength="100"
            placeholder="Press Arnold"
          />
        </div>

        <div>
          <label class="stencil mb-1.5 block" for="e-equipment">
            Equipo <span class="text-ash-dim">(opcional)</span>
          </label>
          <input
            id="e-equipment"
            name="equipment"
            class="field"
            maxlength="50"
            placeholder="Mancuerna"
          />
        </div>

        <div>
          <label class="stencil mb-1.5 block" for="e-kind">Tipo de registro</label>
          <select id="e-kind" name="kind" class="field" required>
            {Object.entries(KINDS).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="stencil mb-1.5 block" for="e-muscle">Músculo principal</label>
          <select id="e-muscle" name="muscleGroupId" class="field">
            <option value="">Sin asignar</option>
            {muscleGroups.map((group) => (
              <option value={group.id}>{group.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div>
        <button type="submit" class="btn btn-primary">Crear ejercicio</button>
      </div>
    </form>
  </section>
</Layout>
