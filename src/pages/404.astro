---
import Layout from '../layouts/Layout.astro'
---

<Layout title="No encontrado">
  <div class="py-20 text-center">
    <p class="readout text-7xl text-steel-hi sm:text-8xl">404</p>
    <h1 class="mt-4 text-2xl">Aquí no hay nada</h1>
    <p class="mt-2 text-ash">La página que buscas no existe o ya no está.</p>
    <a href="/" class="btn btn-primary mt-8">Volver al inicio</a>
  </div>
</Layout>
