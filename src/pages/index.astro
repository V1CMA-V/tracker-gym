---
import { actions } from 'astro:actions'

import Layout from '../layouts/Layout.astro'
import StatTile from '../components/StatTile.astro'
import EmptyState from '../components/EmptyState.astro'
import { prisma } from '../lib/prisma'
import { getCurrentUser } from '../lib/session'
import { compact, date, duration, trim } from '../lib/format'

const user = await getCurrentUser(Astro.locals)

const started = Astro.getActionResult(actions.startSession)
if (started && !started.error) {
  return Astro.redirect(`/sesion/${started.data.id}`, 303)
}
const error = started?.error?.message

// Qué toca hoy: la función del esquema resuelve la prioridad entre el
// calendario y el plan semanal.
const [todayRow] = await prisma.$queryRaw<{ routine_id: string | null }[]>`
  SELECT routine_for_date(${user.id}::uuid, (now() AT TIME ZONE ${user.timezone})::date)
    AS routine_id
`

const suggested = todayRow?.routine_id
  ? await prisma.routine.findUnique({
      where: { id: todayRow.routine_id },
      select: {
        id: true,
        name: true,
        description: true,
        color: true,
        _count: { select: { exercises: true } },
      },
    })
  : null

const openSession = await prisma.workoutSession.findFirst({
  where: { userId: user.id, status: 'in_progress' },
  select: { id: true, routineName: true, startedAt: true },
})

const recent = await prisma.workoutSession.findMany({
  where: { userId: user.id, status: 'completed' },
  orderBy: { startedAt: 'desc' },
  take: 3,
  select: {
    id: true,
    routineName: true,
    startedAt: true,
    endedAt: true,
    _count: { select: { exercises: true } },
  },
})

// Resumen del mes desde la vista.
type MonthRow = {
  sessions: bigint
  total_hours: string | null
  total_volume_kg: string | null
  total_sets: bigint | null
}
const [month] = await prisma.$queryRaw<MonthRow[]>`
  SELECT sessions, total_hours, total_volume_kg, total_sets
  FROM v_monthly_summary
  WHERE user_id = ${user.id}::uuid
    AND month = date_trunc('month', now() AT TIME ZONE ${user.timezone})::date
`

const routineCount = await prisma.routine.count({
  where: { userId: user.id, isArchived: false },
})

const now = new Date()
const greeting = (() => {
  const hour = Number(
    new Intl.DateTimeFormat('es-MX', {
      timeZone: user.timezone,
      hour: 'numeric',
      hour12: false,
    }).format(now),
  )
  if (hour < 6) return 'De madrugada'
  if (hour < 12) return 'Buenos días'
  if (hour < 20) return 'Buenas tardes'
  return 'Buenas noches'
})()

const stats = [
  { label: 'Sesiones', value: String(month?.sessions ?? 0) },
  { label: 'Horas', value: month?.total_hours ? trim(Number(month.total_hours)) : '0' },
  { label: 'Series', value: String(month?.total_sets ?? 0) },
  {
    label: 'Volumen',
    value: month?.total_volume_kg ? compact(Number(month.total_volume_kg)) : '0',
    unit: 'kg',
  },
]
---

<Layout>
  <header class="mb-9">
    <p class="stencil">
      {greeting} · {date(now, user.timezone, { weekday: 'long' })}
    </p>
    <h1 class="mt-2 text-5xl sm:text-6xl">{user.displayName}</h1>
  </header>

  {
    error && (
      <p
        role="alert"
        class="mb-6 rounded-slab border border-signal/40 bg-signal/10 px-4 py-3 text-sm text-signal"
      >
        {error}
      </p>
    )
  }

  <!-- ===== Lo de hoy ===== -->
  {
    openSession ? (
      <section class="slab rise relative overflow-hidden border-sodium/50 p-6 sm:p-7">
        <div
          class="absolute inset-0 opacity-[0.07]"
          style="background:radial-gradient(90% 130% at 0% 0%, var(--color-sodium), transparent 62%)"
          aria-hidden="true"
        />
        <div class="relative">
          <p class="stencil flex items-center gap-2 text-sodium">
            <span class="size-1.5 animate-pulse rounded-full bg-sodium" aria-hidden="true" />
            Entrenamiento en curso
          </p>
          <h2 class="mt-3 text-4xl sm:text-5xl">
            {openSession.routineName ?? 'Entreno libre'}
          </h2>
          <p class="mt-2 text-sm text-ash">
            Empezó a las{' '}
            {date(openSession.startedAt, user.timezone, {
              hour: '2-digit',
              minute: '2-digit',
              day: undefined,
              month: undefined,
            })}
          </p>
          <a href={`/sesion/${openSession.id}`} class="btn btn-primary mt-6 w-full sm:w-auto">
            Continuar entrenando
          </a>
        </div>
      </section>
    ) : suggested ? (
      <section class="slab rise relative overflow-hidden p-6 pl-7 sm:p-7 sm:pl-8">
        {/* Lavado de color de la rutina: identifica el día sin un borde duro. */}
        <div
          class="absolute inset-0 opacity-[0.11]"
          style={`background:radial-gradient(90% 130% at 0% 0%, ${suggested.color ?? '#E8A33D'}, transparent 62%)`}
          aria-hidden="true"
        />
        <span
          class="absolute inset-y-0 left-0 w-[3px]"
          style={`background:linear-gradient(to bottom, ${suggested.color ?? '#E8A33D'}, transparent 85%)`}
          aria-hidden="true"
        />
        <div class="relative">
          <p class="stencil">Hoy toca</p>
          <h2 class="mt-2.5 text-4xl sm:text-5xl">{suggested.name}</h2>
          {suggested.description && (
            <p class="mt-2.5 max-w-prose text-sm leading-relaxed text-ash">
              {suggested.description}
            </p>
          )}
          <p class="stencil mt-4">
            <span class="readout mr-1.5 text-base text-chalk">
              {suggested._count.exercises}
            </span>
            ejercicios
          </p>

          <form method="POST" action={actions.startSession} class="mt-6 flex flex-wrap gap-2.5">
            <input type="hidden" name="routineId" value={suggested.id} />
            <button type="submit" class="btn btn-primary flex-1 sm:flex-none">
              Empezar
            </button>
            <a href={`/rutinas/${suggested.id}`} class="btn btn-ghost">Ver rutina</a>
          </form>
        </div>
      </section>
    ) : routineCount > 0 ? (
      <section class="slab rise p-6 sm:p-7">
        <p class="stencil">Sin plan para hoy</p>
        <h2 class="mt-2.5 text-3xl sm:text-4xl">Elige una rutina o entrena libre</h2>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a href="/rutinas" class="btn btn-primary">Ver rutinas</a>
          <form method="POST" action={actions.startSession}>
            <button type="submit" class="btn btn-ghost">Entreno libre</button>
          </form>
        </div>
        <p class="mt-5 border-t border-steel pt-4 text-sm text-ash-dim">
          ¿Siempre entrenas lo mismo este día?{' '}
          <a href="/rutinas" class="text-sodium underline decoration-sodium/40 underline-offset-2 hover:decoration-sodium">
            Planea tu semana
          </a>{' '}
          y aparecerá aquí solo.
        </p>
      </section>
    ) : (
      <EmptyState
        title="Empieza por una rutina"
        hint="Agrupa los ejercicios que sueles hacer juntos. Después podrás iniciar el entrenamiento con un botón."
      >
        <a href="/rutinas" class="btn btn-primary">Crear mi primera rutina</a>
      </EmptyState>
    )
  }

  <!-- ===== Este mes ===== -->
  <section class="mt-12">
    <h2 class="stencil mb-3">
      {date(now, user.timezone, { month: 'long', day: undefined })} en números
    </h2>
    {/*
      Una sola superficie con separadores de 1px: el `gap-px` deja ver el
      fondo acero y hace las líneas, así que funciona igual con 2 o con 4
      columnas sin pelearse con `divide-*`.
    */}
    <div class="slab grid grid-cols-2 gap-px overflow-hidden bg-steel sm:grid-cols-4">
      {stats.map((stat, i) => <StatTile {...stat} delay={i} />)}
    </div>
  </section>

  <!-- ===== Últimas sesiones ===== -->
  {
    recent.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h2 class="stencil">Últimos entrenamientos</h2>
          <a href="/historial" class="stencil transition-colors hover:text-chalk">
            Ver todo →
          </a>
        </div>

        <ul class="slab divide-y divide-steel overflow-hidden">
          {recent.map((entry, i) => (
            <li
              class="rise flex min-w-0 items-center gap-4 px-4 py-4"
              style={`animation-delay:${i * 60}ms`}
            >
              <div class="min-w-0 flex-1">
                <p class="truncate font-display text-xl leading-tight">
                  {entry.routineName ?? 'Entreno libre'}
                </p>
                <p class="stencil mt-1.5 text-ash-dim">
                  {date(entry.startedAt, user.timezone, { weekday: 'short' })} ·{' '}
                  {entry._count.exercises} ejercicios
                </p>
              </div>
              <span class="readout shrink-0 text-sm text-ash">
                {duration(entry.startedAt, entry.endedAt)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
