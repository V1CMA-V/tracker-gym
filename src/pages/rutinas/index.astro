---
import { actions } from 'astro:actions'

import Layout from '../../layouts/Layout.astro'
import RoutineCard from '../../components/RoutineCard.astro'
import WeekStrip from '../../components/WeekStrip.astro'
import EmptyState from '../../components/EmptyState.astro'
import { prisma } from '../../lib/prisma'
import { getCurrentUser } from '../../lib/session'
import { backTo, dayOfWeekIn, weekDayLabels } from '../../lib/format'

const user = await getCurrentUser(Astro.locals)

// POST-redirect-GET: tras crear, se salta al detalle para seguir armándola.
const created = Astro.getActionResult(actions.createRoutine)
if (created && !created.error) {
  return Astro.redirect(`/rutinas/${created.data.id}`, 303)
}

// Guardar la semana recarga esta misma página.
const scheduled = Astro.getActionResult(actions.setWeeklySchedule)
if (scheduled && !scheduled.error) {
  return Astro.redirect(backTo(Astro.url), 303)
}

// Cada error se muestra junto al formulario que lo produjo.
const error = created?.error?.message
const scheduleError = scheduled?.error?.message

// Una sola query: rutinas + sus ejercicios + el grupo muscular de cada uno.
const routines = await prisma.routine.findMany({
  where: { userId: user.id, isArchived: false },
  orderBy: { createdAt: 'asc' },
  select: {
    id: true,
    name: true,
    description: true,
    color: true,
    _count: { select: { exercises: true } },
    exercises: {
      select: {
        exercise: {
          select: {
            muscles: {
              where: { isPrimary: true },
              select: { muscleGroup: { select: { name: true } } },
            },
          },
        },
      },
    },
  },
})

// Plan semanal: qué rutina toca cada día. Es lo que lee la página Hoy.
const schedule = await prisma.weeklySchedule.findMany({
  where: { userId: user.id },
  select: { dayOfWeek: true, routineId: true },
})
const assigned = new Map(schedule.map((row) => [row.dayOfWeek, row.routineId]))

/** Días que le tocan a una rutina, ya abreviados: ["Lun", "Jue"]. */
const daysOf = (routineId: string) =>
  weekDayLabels(
    schedule.filter((row) => row.routineId === routineId).map((row) => row.dayOfWeek),
  )

/** Grupos musculares distintos que toca la rutina, en orden de aparición. */
const musclesOf = (routine: (typeof routines)[number]) => [
  ...new Set(
    routine.exercises.flatMap((re) =>
      re.exercise.muscles.map((m) => m.muscleGroup.name),
    ),
  ),
]

const palette = ['#E8A33D', '#C8372D', '#2B5FAE', '#6FB98A', '#C8A02D', '#9AA0A6']
---

<Layout title="Rutinas">
  <header class="mb-9 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="stencil">Plantillas</p>
      <h1 class="mt-2 text-5xl sm:text-6xl">Rutinas</h1>
    </div>
    <p class="readout text-4xl text-steel-hi">
      {String(routines.length).padStart(2, '0')}
    </p>
  </header>

  {
    scheduleError && (
      <p
        role="alert"
        class="mb-5 rounded-slab border border-signal/40 bg-signal/10 px-4 py-3 text-sm text-signal"
      >
        {scheduleError}
      </p>
    )
  }

  {
    routines.length > 0 && (
      <div class="mb-8">
        <WeekStrip
          routines={routines}
          assigned={assigned}
          today={dayOfWeekIn(user.timezone)}
        />
      </div>
    )
  }

  {
    routines.length > 0 ? (
      <div class="grid gap-3.5 sm:grid-cols-2">
        {routines.map((routine, i) => (
          <RoutineCard
            id={routine.id}
            name={routine.name}
            description={routine.description}
            color={routine.color}
            exerciseCount={routine._count.exercises}
            muscles={musclesOf(routine)}
            days={daysOf(routine.id)}
            delay={i}
          />
        ))}
      </div>
    ) : (
      <EmptyState
        title="Todavía no hay rutinas"
        hint="Una rutina es una plantilla: los ejercicios que sueles hacer juntos, en orden, con sus series y pesos objetivo."
      />
    )
  }

  <!-- Alta de rutina -->
  <section class="slab mt-12 p-5 sm:p-6">
    <h2 class="text-2xl">Nueva rutina</h2>

    {
      error && (
        <p
          role="alert"
          class="mt-4 rounded-slab border border-signal/40 bg-signal/10 px-4 py-3 text-sm text-signal"
        >
          {error}
        </p>
      )
    }

    <form method="POST" action={actions.createRoutine} class="mt-4 grid gap-4">
      <div class="grid gap-4 sm:grid-cols-[1fr_auto]">
        <div>
          <label class="stencil mb-1.5 block" for="name">Nombre</label>
          <input
            id="name"
            name="name"
            class="field"
            required
            maxlength="100"
            placeholder="Empuje, Jalón, Pierna…"
          />
        </div>

        <fieldset class="min-w-0">
          <legend class="stencil mb-1.5">Color</legend>
          <div class="flex flex-wrap gap-1.5">
            {palette.map((hex, i) => (
              <label class="cursor-pointer" title={hex}>
                <input
                  type="radio"
                  name="color"
                  value={hex}
                  checked={i === 0}
                  class="peer sr-only"
                />
                <span
                  class="block size-9 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-panel transition-all peer-checked:ring-chalk peer-focus-visible:ring-sodium"
                  style={`background:${hex}`}
                />
                <span class="sr-only">{hex}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <div>
        <label class="stencil mb-1.5 block" for="description">
          Descripción <span class="text-ash-dim">(opcional)</span>
        </label>
        <input
          id="description"
          name="description"
          class="field"
          placeholder="Pecho, hombro y tríceps"
        />
      </div>

      <div>
        <button type="submit" class="btn btn-primary">Crear rutina</button>
      </div>
    </form>
  </section>
</Layout>
